{
  "$comment": "段首宏大帽句与段尾升华套话的正则规则。position: head=仅段首句生效, tail=仅段末句生效, any=任意位置。regex 为 Python re 语法，匹配时附加 re.IGNORECASE 无意义（中文），但保留标志位以兼容中英混排。severity 用于加权：3 为可整句删除的纯铺垫，2 为需改写，1 为提示。",
  "version": "1.0.0",
  "lang": "zh",
  "patterns": [
    {
      "id": "zh_head_era_background",
      "position": "head",
      "regex": "^[^。！？]{0,12}(?:在当今|当今|在当前|当前|在新)(?:社会|时代|世界|背景下|形势下|语境下|阶段)[^。！？]{0,40}[。！？]",
      "severity": 3,
      "message": "段首时代背景帽句：审稿人不需要被告知「当今时代」，直接从本段的具体论点起笔。"
    },
    {
      "id": "zh_head_with_development",
      "position": "head",
      "regex": "^[^。！？]{0,10}随着(?:[^。！？]{0,20})(?:的(?:不断|持续|快速|迅速|日益)?(?:发展|进步|推进|深入|普及|成熟|完善|应用))[^。！？]{0,40}[。！？]",
      "severity": 3,
      "message": "「随着……的发展」式开场：信息量为零的铺垫，建议删除整句或替换为具体的时间与数据变化。"
    },
    {
      "id": "zh_head_recent_years",
      "position": "head",
      "regex": "^近(?:年来|些年|几年|十年)[^。！？]{0,50}(?:受到|引起|得到|成为)[^。！？]{0,20}(?:关注|重视|热点|焦点)[^。！？]{0,20}[。！？]",
      "severity": 2,
      "message": "「近年来受到广泛关注」：需补充是谁的关注、哪一年起、引用量或论文数等具体锚点。"
    },
    {
      "id": "zh_head_importance_claim",
      "position": "head",
      "regex": "^[^。！？]{0,30}(?:作为|是)[^。！？]{0,20}(?:的)?(?:重要|关键|核心|基础)(?:组成部分|环节|内容|手段|途径|支撑|保障)[^。！？]{0,30}[。！？]",
      "severity": 2,
      "message": "段首价值定性句：把「重要」换成它为什么重要的可验证事实。"
    },
    {
      "id": "zh_head_well_known",
      "position": "head",
      "regex": "^(?:众所周知|毋庸置疑|不言而喻|无可否认|不可否认|显而易见)[，,][^。！？]{0,60}[。！？]",
      "severity": 3,
      "message": "「众所周知」开场：若真属公知无需写，若不属则需引文支撑。"
    },
    {
      "id": "zh_head_definition_filler",
      "position": "head",
      "regex": "^[^。！？]{0,20}(?:是指|指的是|是一种|是一个)[^。！？]{0,30}(?:方法|技术|模型|框架|体系|机制|过程|现象)[，,。]",
      "severity": 1,
      "message": "段首教科书式定义：若读者已具备该背景，此句可删或并入上下文。"
    },
    {
      "id": "zh_head_problem_framing",
      "position": "head",
      "regex": "^[^。！？]{0,15}(?:然而|但是|不过)[，,][^。！？]{0,20}(?:现有|已有|传统|目前)(?:的)?(?:研究|方法|技术|模型|工作)[^。！？]{0,20}(?:仍|还|尚)(?:然)?(?:存在|面临|具有)[^。！？]{0,20}(?:不足|问题|局限|挑战|缺陷)[^。！？]{0,20}[。！？]",
      "severity": 2,
      "message": "泛化的「现有方法仍存在不足」：需指明是哪一篇、哪个指标、差距多少。"
    },
    {
      "id": "zh_tail_significance",
      "position": "tail",
      "regex": "[^。！？]{0,40}(?:具有(?:重要|重大|一定)的?(?:理论|现实|实践|指导|参考|应用)?(?:意义|价值|作用)|意义重大|价值凸显)[^。！？]{0,20}[。！？]$",
      "severity": 3,
      "message": "段尾意义升华句：删除后段落信息量不减，建议整句删掉。"
    },
    {
      "id": "zh_tail_prospect",
      "position": "tail",
      "regex": "[^。！？]{0,40}(?:(?:具有|展现出|展现了|拥有)(?:广阔|巨大|良好|广泛)的?(?:应用)?(?:前景|潜力|空间)|前景广阔|潜力巨大)[^。！？]{0,20}[。！？]$",
      "severity": 3,
      "message": "段尾前景展望套话：除非本段给出了支撑该前景的具体数据，否则删除。"
    },
    {
      "id": "zh_tail_provide_reference",
      "position": "tail",
      "regex": "[^。！？]{0,40}(?:为(?:后续|相关|未来|进一步)[^。！？]{0,15}(?:研究|工作|实践|应用)提供(?:了)?[^。！？]{0,15}(?:参考|借鉴|思路|依据|基础|支撑)|提供了(?:新的)?思路|提供了有益借鉴)[^。！？]{0,20}[。！？]$",
      "severity": 3,
      "message": "「为后续研究提供参考」：几乎所有论文都能这么写，因此等于没写。"
    },
    {
      "id": "zh_tail_lay_foundation",
      "position": "tail",
      "regex": "[^。！？]{0,40}(?:奠定了?(?:坚实)?(?:的)?基础|打下了?(?:坚实)?(?:的)?基础|开辟了?(?:新的)?(?:路径|道路|方向)|指明了方向)[^。！？]{0,20}[。！？]$",
      "severity": 3,
      "message": "段尾「奠定基础/开辟路径」：空洞的自我评价，审稿人会视为灌水。"
    },
    {
      "id": "zh_tail_positive_role",
      "position": "tail",
      "regex": "[^。！？]{0,40}(?:(?:起到|起|发挥)(?:了)?(?:积极|重要|关键|促进)(?:的)?(?:作用|功效)|取得了?(?:显著|良好|积极)(?:的)?(?:成效|效果|成果|进展))[^。！？]{0,20}[。！？]$",
      "severity": 3,
      "message": "段尾「发挥了重要作用/取得显著成效」：需替换为具体指标的前后对比数值。"
    },
    {
      "id": "zh_tail_need_further",
      "position": "tail",
      "regex": "[^。！？]{0,40}(?:有待(?:进一步|深入)?(?:研究|探讨|验证|完善)|仍需(?:进一步|深入)(?:研究|探讨|验证|完善)|值得(?:进一步)?深入探讨)[^。！？]{0,20}[。！？]$",
      "severity": 2,
      "message": "「有待进一步研究」：若是本文局限应写明具体局限，否则删除。"
    },
    {
      "id": "zh_tail_summary_connector",
      "position": "tail",
      "regex": "^(?:综上所述|综上|总而言之|总的来说|总体而言|概而言之|简而言之|一言以蔽之|归根结底|由上可知|归纳起来)[，,]",
      "severity": 2,
      "message": "显性总结连接词开头：段落逻辑若清晰则无需宣告「我要总结了」。"
    },
    {
      "id": "zh_tail_future_outlook",
      "position": "tail",
      "regex": "[^。！？]{0,40}(?:未来(?:将|会|可以|有望|仍需)[^。！？]{0,25}|今后[^。！？]{0,25})(?:发展|完善|优化|探索|拓展|深化)[^。！？]{0,20}[。！？]$",
      "severity": 2,
      "message": "段尾未来展望：正文段落通常不需要，留给结论章节且需写具体计划。"
    },
    {
      "id": "zh_any_dual_importance",
      "position": "any",
      "regex": "(?:不仅|不但)[^。！？]{0,30}(?:而且|并且|还|也)[^。！？]{0,30}(?:重要|关键|必要|有效|显著)",
      "severity": 1,
      "message": "「不仅……而且……」对称强调句式：AI 高频句型，建议拆为两句不对称表述。"
    },
    {
      "id": "zh_any_through_achieve",
      "position": "any",
      "regex": "通过[^。！？]{2,30}(?:，|,)?(?:从而|进而|有效|成功)?(?:实现|达到|完成|获得)了?[^。！？]{0,25}",
      "severity": 1,
      "message": "「通过……实现了……」对称介词句式：改为主动语态的具体动作与结果。"
    },
    {
      "id": "zh_any_at_same_time",
      "position": "any",
      "regex": "(?:与此同时|同时)[，,][^。！？]{0,20}(?:也|还|亦)[^。！？]{0,30}",
      "severity": 1,
      "message": "「与此同时……也……」：可直接删连接词并句。"
    },
    {
      "id": "zh_any_multi_dimension",
      "position": "any",
      "regex": "(?:多(?:维|维度|方面|层次|层面|角度)|全(?:方位|链条|周期|要素)|深层次)[^。！？]{0,10}(?:地)?(?:分析|研究|考察|审视|构建|优化|推进|提升)",
      "severity": 2,
      "message": "「多维度/全方位+动词」：请列出究竟是哪几个维度。"
    },
    {
      "id": "zh_any_empower",
      "position": "any",
      "regex": "(?:赋能|抓手|闭环|顶层设计|长效机制|生态(?:构建|闭环)|新动能|增长极|提质增效|降本增效)",
      "severity": 2,
      "message": "管理学话语词：在学术正文中几乎总可以替换为具体机制描述。"
    },
    {
      "id": "zh_any_research_shows",
      "position": "any",
      "regex": "(?:研究|实践|事实|分析|数据|结果)(?:表明|显示|证明|指出)[，,]?(?![^。！？]{0,30}\\{\\{CITE)",
      "severity": 2,
      "message": "「研究表明」但无引文：需补文献引用，否则属无源断言。"
    },
    {
      "id": "zh_any_scholars_attention",
      "position": "any",
      "regex": "(?:诸多|众多|许多|不少|越来越多的)(?:学者|研究者|研究人员|专家)[^。！？]{0,20}(?:关注|研究|探讨|指出|认为)",
      "severity": 2,
      "message": "「诸多学者认为」：点名具体文献，不要用集体名词代替引用。"
    },
    {
      "id": "zh_any_vague_improve",
      "position": "any",
      "regex": "(?:显著|大幅|明显|有效|极大|充分)(?:地)?(?:提升|提高|改善|优化|增强|降低|减少|缓解|促进)(?![^。！？]{0,15}(?:\\d|\\{\\{))",
      "severity": 2,
      "message": "程度副词+提升但无数值：补充提升了多少（百分比或绝对值）。"
    },
    {
      "id": "zh_any_abstract_mechanism",
      "position": "any",
      "regex": "(?:内在|深层|本质|客观|一般|普遍)(?:的)?(?:机理|机制|逻辑|规律|特征|属性|联系)",
      "severity": 1,
      "message": "抽象机理名词：说明具体是什么机制、经由哪条路径作用。"
    },
    {
      "id": "zh_any_complex_scenario",
      "position": "any",
      "regex": "(?:复杂|实际|真实|现实)(?:的)?(?:场景|环境|条件|工况|情形|应用场景)",
      "severity": 2,
      "message": "「复杂场景」：指明具体是哪种场景、哪些干扰因素。"
    },
    {
      "id": "zh_any_good_robustness",
      "position": "any",
      "regex": "具有(?:良好|较好|较强|一定|优异|出色)的?(?:鲁棒性|稳定性|泛化(?:性|能力)|可解释性|实用性|适用性|扩展性|准确性)",
      "severity": 2,
      "message": "「具有良好的鲁棒性」：需给出在何种扰动下、指标波动范围是多少。"
    },
    {
      "id": "zh_any_rhetorical_question",
      "position": "any",
      "regex": "(?:那么|究竟|到底)[^。！？]{0,30}(?:呢[？?]|[？?])",
      "severity": 2,
      "message": "设问句：学术正文慎用自问自答结构，直接给出论断。"
    },
    {
      "id": "zh_any_triple_parallel",
      "position": "any",
      "regex": "(?:[\\u4e00-\\u9fff]{2,6})(?:、[\\u4e00-\\u9fff]{2,6}){2,}(?:等)?(?:方面|维度|问题|因素|特征|层面)",
      "severity": 1,
      "message": "三项以上顿号排比：AI 高频结构，考虑拆句或改为分点论述。"
    },
    {
      "id": "zh_any_not_only_but",
      "position": "any",
      "regex": "既[^。！？]{2,25}又[^。！？]{2,25}",
      "severity": 1,
      "message": "「既……又……」对称句式：句法骨架高度规整，建议打破对称。"
    },
    {
      "id": "zh_any_it_is_worth",
      "position": "any",
      "regex": "值得(?:注意|一提|强调|关注|指出)的是[，,]",
      "severity": 3,
      "message": "「值得注意的是」：删掉后句意完整，是纯粹的注意力宣告词。"
    },
    {
      "id": "zh_any_need_to_point",
      "position": "any",
      "regex": "(?:需要|有必要|应当)(?:注意|指出|强调|说明)(?:的是)?[，,]",
      "severity": 3,
      "message": "「需要指出的是」：同上，直接说内容。"
    },
    {
      "id": "zh_any_obvious_inference",
      "position": "any",
      "regex": "(?:由此可见|由此可知|不难看出|不难发现|不难理解|可以看出|可以发现)[，,]",
      "severity": 2,
      "message": "「由此可见」：推论若成立读者自会看出，不必代替读者下结论。"
    },
    {
      "id": "zh_any_in_other_words",
      "position": "any",
      "regex": "(?:换言之|换句话说|也就是说|亦即|简言之)[，,]",
      "severity": 2,
      "message": "「换言之」：若前句已表达清楚则此句冗余，若没有则应改写前句。"
    },
    {
      "id": "zh_any_increasingly",
      "position": "any",
      "regex": "(?:日益|愈发|越来越|逐渐|不断)(?:凸显|突出|重要|严峻|完善|深化|加强)",
      "severity": 2,
      "message": "「日益凸显」类趋势词：给出趋势的量化证据或时间区间。"
    },
    {
      "id": "zh_any_cannot_ignore",
      "position": "any",
      "regex": "(?:不可|不容|无法)(?:忽视|忽略|回避)|(?:至关重要|尤为(?:重要|关键)|举足轻重)",
      "severity": 2,
      "message": "「不可忽视/至关重要」：用后果说明重要性，而非直接断言重要。"
    }
  ]
}
