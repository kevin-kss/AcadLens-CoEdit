# 统一文本文件换行为 LF，避免 macOS/Windows 协作时整文件 diff
* text=auto eol=lf

# 脚本强制 LF
*.sh   text eol=lf
*.py   text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf

# 二进制与资源文件不做换行转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.docx binary
*.gguf binary
*.safetensors binary

# 词库为 UTF-8 文本，参与 diff
*.txt  text eol=lf
*.json text eol=lf

# 锁文件在 PR 中折叠显示
pnpm-lock.yaml   linguist-generated=true -diff
package-lock.json linguist-generated=true -diff
poetry.lock      linguist-generated=true -diff
uv.lock          linguist-generated=true -diff
